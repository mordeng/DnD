<div class="character-card" data-character-id="{{character.slug}}">
    <div class="character-card-header">
        <img src="/assets/images/characters/{{character.slug}}.jpg"
             alt="{{character.name}} Portrait"
             class="character-portrait"
             onerror="this.src='/assets/images/character-placeholder.png'">
        <div class="character-badge status-{{character.status}}">
            {{#if (eq character.status 'active')}}Active{{/if}}
            {{#if (eq character.status 'retired')}}Retired{{/if}}
            {{#if (eq character.status 'deceased')}}†{{/if}}
        </div>
    </div>

    <div class="character-card-body">
        <h3 class="character-name">
            <a href="/characters/{{character.slug}}.html">{{character.name}}</a>
        </h3>
        <p class="character-class">{{character.race}} {{character.class}} • Level {{character.level}}</p>

        {{#if character.excerpt}}
        <p class="character-excerpt">{{character.excerpt}}</p>
        {{/if}}

        {{#if character.quest}}
        <div class="character-meta">
            <span class="meta-item">
                <svg class="icon" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="10" cy="10" r="8"/>
                    <line x1="14" y1="6" x2="6" y2="14"/>
                </svg>
                Quest: {{character.quest}}
            </span>
        </div>
        {{/if}}

        {{#if character.faction}}
        <div class="character-meta">
            <span class="meta-item">
                <svg class="icon" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M10 2l8 4v6c0 4-8 8-8 8s-8-4-8-8V6l8-4z"/>
                </svg>
                {{character.faction}}
            </span>
        </div>
        {{/if}}
    </div>

    <div class="character-card-footer">
        <a href="/characters/{{character.slug}}.html" class="btn btn-sm btn-outline">
            Profil ansehen
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="10" x2="15" y2="10"/>
                <polyline points="10,5 15,10 10,15"/>
            </svg>
        </a>
    </div>
</div>
