<!-- Character Header -->
<header class="character-header">
    <div class="character-portrait-large">
        <img src="{{site.baseUrl}}assets/images/characters/{{page.slug}}.jpg"
             alt="{{page.title}} Portrait"
             onerror="this.src='/assets/images/character-placeholder.png'">
        <div class="character-badge status-{{page.status}}">
            {{#if (eq page.status 'active')}}Active{{/if}}
            {{#if (eq page.status 'retired')}}Retired{{/if}}
            {{#if (eq page.status 'deceased')}}Verstorben{{/if}}
        </div>
    </div>

    <div class="character-header-content">
        <h1 class="character-title">{{page.title}}</h1>
        <p class="character-subtitle">{{page.race}} {{page.class}} • Level {{page.level}}</p>

        {{#if page.faction}}
        <div class="character-faction">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 2l8 4v6c0 4-8 8-8 8s-8-4-8-8V6l8-4z"/>
            </svg>
            <a href="{{site.baseUrl}}factions/{{page.factionSlug}}.html">{{page.faction}}</a>
        </div>
        {{/if}}

        {{#if page.tags}}
        <div class="character-tags">
            {{#each page.tags}}
            <span class="tag">{{this}}</span>
            {{/each}}
        </div>
        {{/if}}
    </div>
</header>

<!-- Character Stats (if available) -->
{{#if page.stats}}
<section class="character-stats">
    <h2>Stats & Abilities</h2>
    <div class="stat-grid">
        {{#each page.stats}}
        <div class="stat-box">
            <span class="stat-name">{{this.name}}</span>
            <span class="stat-value">{{this.value}}</span>
            {{#if this.modifier}}
            <span class="stat-modifier">{{this.modifier}}</span>
            {{/if}}
        </div>
        {{/each}}
    </div>
</section>
{{/if}}

<!-- Main Content -->
<div class="character-content">
    {{{page.htmlContent}}}
</div>

<!-- Character Quest -->
{{#if page.quest}}
<section class="character-quest">
    <h2>
        <svg width="24" height="24" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="10" cy="10" r="8"/>
            <line x1="14" y1="6" x2="6" y2="14"/>
        </svg>
        Persönliche Quest
    </h2>
    <div class="quest-card">
        <h3>
            <a href="{{page.quest.url}}">{{page.quest.title}}</a>
        </h3>
        <p>{{page.quest.description}}</p>

        {{#if page.quest.progress}}
        <div class="progress-bar">
            <div class="progress-fill" style="width: {{page.quest.progress}}%">
                <span class="progress-label">{{page.quest.progress}}%</span>
            </div>
        </div>
        {{/if}}

        <a href="{{page.quest.url}}" class="btn btn-sm btn-outline">Quest Details ansehen</a>
    </div>
</section>
{{/if}}

<!-- Character Items -->
{{#if page.items}}
<section class="character-items">
    <h2>
        <svg width="24" height="24" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="10,2 2,7 2,13 10,18 18,13 18,7"/>
            <polyline points="2,7 10,12 18,7"/>
            <line x1="10" y1="18" x2="10" y2="12"/>
        </svg>
        Ausrüstung & Items
    </h2>
    <div class="item-list">
        {{#each page.items}}
        <div class="item-card">
            <h3>
                <a href="{{this.url}}">{{this.name}}</a>
            </h3>
            <span class="item-rarity rarity-{{this.rarity}}">{{this.rarityLabel}}</span>
            <p>{{this.description}}</p>
        </div>
        {{/each}}
    </div>
</section>
{{/if}}

<!-- Key Moments (from sessions) -->
{{#if page.keyMoments}}
<section class="character-moments">
    <h2>
        <svg width="24" height="24" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
        </svg>
        Schlüsselmomente
    </h2>
    <div class="timeline">
        {{#each page.keyMoments}}
        <div class="timeline-entry">
            <div class="timeline-marker"></div>
            <div class="timeline-content">
                <div class="timeline-header">
                    <span class="timeline-day">Tag {{this.day}}</span>
                    <span class="timeline-location">{{this.location}}</span>
                </div>
                <p class="timeline-description">{{this.description}}</p>
                <a href="{{this.sessionUrl}}" class="timeline-link">Session Details →</a>
            </div>
        </div>
        {{/each}}
    </div>
</section>
{{/if}}

<!-- Relationships -->
{{#if page.relationships}}
<section class="character-relationships">
    <h2>
        <svg width="24" height="24" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 18v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2"/>
            <circle cx="10" cy="5" r="4"/>
        </svg>
        Beziehungen
    </h2>
    <div class="relationship-grid">
        {{#each page.relationships}}
        <div class="relationship-card relationship-{{this.type}}">
            <div class="relationship-header">
                <a href="{{this.url}}">
                    <img src="{{site.baseUrl}}assets/images/characters/{{this.slug}}.jpg"
                         alt="{{this.name}}"
                         class="relationship-avatar"
                         onerror="this.src='/assets/images/character-placeholder.png'">
                </a>
                <div>
                    <h4><a href="{{this.url}}">{{this.name}}</a></h4>
                    <span class="relationship-type">{{this.typeLabel}}</span>
                </div>
            </div>
            <p class="relationship-description">{{this.description}}</p>
        </div>
        {{/each}}
    </div>
</section>
{{/if}}
