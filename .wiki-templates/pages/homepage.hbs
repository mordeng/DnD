<!-- Hero Section -->
<section class="hero">
    <div class="hero-content">
        <h1 class="hero-title">{{site.title}}</h1>
        <p class="hero-subtitle">{{site.subtitle}}</p>

        <div class="hero-stats">
            <div class="stat">
                <span class="stat-value">{{site.currentDay}}</span>
                <span class="stat-label">Tage gereist</span>
            </div>
            <div class="stat">
                <span class="stat-value">{{site.statistics.sessions}}</span>
                <span class="stat-label">Sessions</span>
            </div>
            <div class="stat">
                <span class="stat-value">3</span>
                <span class="stat-label">Story Arcs</span>
            </div>
            <div class="stat">
                <span class="stat-value">6</span>
                <span class="stat-label">Heroes</span>
            </div>
        </div>

        <div class="hero-actions">
            <a href="/timeline.html" class="btn btn-primary">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="10" cy="10" r="8"/>
                    <polyline points="10,5 10,10 13,13"/>
                </svg>
                Timeline ansehen
            </a>
            <a href="/characters/" class="btn btn-outline">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 18v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2"/>
                    <circle cx="10" cy="5" r="4"/>
                </svg>
                Die Party kennenlernen
            </a>
        </div>
    </div>
</section>

<!-- Current Status -->
<section class="current-status">
    <div class="status-card">
        <h2>
            <svg width="24" height="24" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 2l8 4v6c0 4-8 8-8 8s-8-4-8-8V6l8-4z"/>
            </svg>
            Aktueller Status
        </h2>
        <div class="status-content">
            <div class="status-item">
                <span class="status-label">Tag</span>
                <span class="status-value">{{site.currentDay}}</span>
            </div>
            <div class="status-item">
                <span class="status-label">Arc</span>
                <span class="status-value">{{site.currentArc}} (3/3)</span>
            </div>
            <div class="status-item">
                <span class="status-label">Ort</span>
                <span class="status-value">{{site.currentLocation}}</span>
            </div>
            <div class="status-item">
                <span class="status-label">Party Level</span>
                <span class="status-value">10</span>
            </div>
        </div>
    </div>
</section>

<!-- Recent Updates -->
{{#if recentUpdates}}
<section class="recent-updates">
    <h2>
        <svg width="24" height="24" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="17,1 21,5 17,9"/>
            <path d="M3 11V9a4 4 0 014-4h14"/>
        </svg>
        Letzte Aktualisierungen
    </h2>
    <div class="update-list">
        {{#each recentUpdates}}
        <article class="update-card">
            <div class="update-meta">
                <span class="update-type update-type-{{this.type}}">{{this.typeLabel}}</span>
                <span class="update-date">{{this.dateFormatted}}</span>
            </div>
            <h3 class="update-title">
                <a href="{{this.url}}">{{this.title}}</a>
            </h3>
            <p class="update-excerpt">{{this.excerpt}}</p>
        </article>
        {{/each}}
    </div>
</section>
{{/if}}

<!-- Quick Links Grid -->
<section class="quick-links">
    <h2>
        <svg width="24" height="24" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="10" cy="10" r="8"/>
            <line x1="10" y1="6" x2="10" y2="10"/>
            <line x1="10" y1="14" x2="10.01" y2="14"/>
        </svg>
        Kampagne erkunden
    </h2>
    <div class="link-grid">
        <a href="/timeline.html" class="link-card">
            <svg class="link-icon" width="32" height="32" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="10" cy="10" r="8"/>
                <polyline points="10,5 10,10 13,13"/>
            </svg>
            <h3>Timeline</h3>
            <p>{{site.currentDay}} Tage voller Abenteuer</p>
        </a>

        <a href="/characters/" class="link-card">
            <svg class="link-icon" width="32" height="32" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 18v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2"/>
                <circle cx="10" cy="5" r="4"/>
            </svg>
            <h3>Characters</h3>
            <p>6 Helden, {{site.statistics.npcs}} NPCs</p>
        </a>

        <a href="/locations/" class="link-card">
            <svg class="link-icon" width="32" height="32" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 2a7 7 0 017 7c0 5-7 11-7 11S3 14 3 9a7 7 0 017-7z"/>
                <circle cx="10" cy="9" r="2"/>
            </svg>
            <h3>Locations</h3>
            <p>Von Moreva bis Avernus</p>
        </a>

        <a href="/quests/" class="link-card">
            <svg class="link-icon" width="32" height="32" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="10" cy="10" r="8"/>
                <line x1="14" y1="6" x2="6" y2="14"/>
            </svg>
            <h3>Quests</h3>
            <p>7 aktive Storylines</p>
        </a>

        <a href="/sessions/" class="link-card">
            <svg class="link-icon" width="32" height="32" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 2h12a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V4a2 2 0 012-2z"/>
                <polyline points="14,2 14,6 10,6 10,2"/>
            </svg>
            <h3>Sessions</h3>
            <p>Session-Notizen lesen</p>
        </a>

        <a href="/items/" class="link-card">
            <svg class="link-icon" width="32" height="32" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="10,2 2,7 2,13 10,18 18,13 18,7"/>
                <polyline points="2,7 10,12 18,7"/>
                <line x1="10" y1="18" x2="10" y2="12"/>
            </svg>
            <h3>Items</h3>
            <p>Magische Schätze</p>
        </a>
    </div>
</section>

<!-- Party Roster -->
<section class="party-roster">
    <h2>
        <svg width="24" height="24" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 18v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2"/>
            <circle cx="10" cy="5" r="4"/>
        </svg>
        Die Party
    </h2>
    <div class="character-grid">
        {{#each site.characters}}
        {{> character-card character=this}}
        {{/each}}
    </div>
</section>
