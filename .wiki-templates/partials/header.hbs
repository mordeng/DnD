<header class="wiki-header">
    <div class="header-container">
        <!-- Logo & Title -->
        <div class="header-brand">
            <a href="{{site.baseUrl}}" class="header-logo-link">
                <svg class="header-logo" width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="2" fill="none"/>
                    <path d="M20 8 L20 32 M8 20 L32 20" stroke="currentColor" stroke-width="2"/>
                    <circle cx="20" cy="20" r="5" fill="currentColor"/>
                </svg>
            </a>
            <div class="header-title">
                <h1><a href="{{site.baseUrl}}">{{site.title}}</a></h1>
                <span class="header-subtitle">Tag {{site.currentDay}} • {{site.currentArc}} • {{site.currentLocation}}</span>
            </div>
        </div>

        <!-- Main Navigation (Desktop) -->
        <nav class="header-nav" aria-label="Primary navigation">
            <a href="{{site.baseUrl}}" class="nav-link">Home</a>
            <a href="{{site.baseUrl}}timeline.html" class="nav-link">Timeline</a>
            <a href="{{site.baseUrl}}characters/" class="nav-link">Characters</a>
            <a href="{{site.baseUrl}}sessions/" class="nav-link">Sessions</a>
            <a href="{{site.baseUrl}}quests/" class="nav-link">Quests</a>
        </nav>

        <!-- Utility Controls -->
        <div class="header-utils">
            <!-- Search Toggle -->
            <button class="header-search-toggle" aria-label="Suche öffnen" title="Suche (Cmd/Ctrl + K)">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="8" cy="8" r="6"/>
                    <line x1="12" y1="12" x2="18" y2="18"/>
                </svg>
            </button>

            <!-- Theme Toggle -->
            <button class="theme-toggle" aria-label="Theme wechseln" title="Dark Mode">
                <svg class="sun-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="10" cy="10" r="4"/>
                    <line x1="10" y1="1" x2="10" y2="3"/>
                    <line x1="10" y1="17" x2="10" y2="19"/>
                    <line x1="1" y1="10" x2="3" y2="10"/>
                    <line x1="17" y1="10" x2="19" y2="10"/>
                </svg>
                <svg class="moon-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
                </svg>
            </button>

            <!-- DM Mode Toggle -->
            <button class="dm-mode-toggle" aria-label="DM Modus" title="DM Modus (Spoiler anzeigen)">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 10s3-7 9-7 9 7 9 7-3 7-9 7-9-7-9-7z"/>
                    <circle cx="10" cy="10" r="3"/>
                </svg>
                <span class="dm-mode-label">DM</span>
            </button>

            <!-- Mobile Menu Toggle -->
            <button class="mobile-menu-toggle" aria-label="Menu" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </div>

    <!-- Search Overlay -->
    <div class="search-overlay" hidden>
        <div class="search-modal">
            <div class="search-input-wrapper">
                <svg class="search-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="8" cy="8" r="6"/>
                    <line x1="12" y1="12" x2="18" y2="18"/>
                </svg>
                <input type="search"
                       class="search-input"
                       placeholder="Suche nach Charakteren, Orten, Sessions..."
                       aria-label="Suche"
                       autocomplete="off"
                       spellcheck="false">
                <button class="search-close" aria-label="Suche schließen">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="4" y1="4" x2="16" y2="16"/>
                        <line x1="16" y1="4" x2="4" y2="16"/>
                    </svg>
                </button>
            </div>

            <div class="search-results-container">
                <div class="search-empty" hidden>
                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="20" cy="20" r="12"/>
                        <line x1="28" y1="28" x2="42" y2="42"/>
                    </svg>
                    <p>Keine Ergebnisse für "<span class="search-query"></span>"</p>
                </div>
                <div class="search-results"></div>
            </div>
        </div>
    </div>
</header>
